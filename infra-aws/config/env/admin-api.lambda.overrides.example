# Lambda-specific overrides merged on top of your VPS `.env` at package time.

CORE_API_URL=https://mobile-api.novasafe.io

LOG_ENABLE_FILE=false
LOG_ENABLE_CONSOLE=true
LOG_DIR=/tmp/logs

# Blog media — google_drive (recommended on Lambda) or local
MEDIA_PROVIDER=google_drive
GOOGLE_DRIVE_FOLDER_ID=
# Set in S3 admin-api/.env (never commit): GOOGLE_SERVICE_ACCOUNT_JSON=...
MEDIA_STORAGE_CACHE_ENABLED=true
MEDIA_STORAGE_PATH=/tmp/uploads

ADMIN_PORT=3130
PORT=3130
BIND_HOST=127.0.0.1
